# Pokémon Emerald PPO configuration
# Switch the whole operating profile by changing this one line or using --profile NAME.
# Choices: fast_train, gui_train, gui_watch, fast_watch
POKEMON_AI_PROFILE=fast_train

# Training size (used only for headless training). GUI training and all watch profiles use one emulator.
POKEMON_AI_NUM_ENVS=8

# Stable-Baselines3 output: 0=quiet, 1=normal, 2=debug
POKEMON_AI_VERBOSE=1

# mGBA native logging: fatal/errors/warnings, with routine traces filtered separately
POKEMON_AI_MGBA_LOG_LEVEL=7
POKEMON_AI_FILTER_MGBA_CHATTER=1
POKEMON_AI_FILTER_KNOWN_MGBA_WARNINGS=1

# PPO transition intervals
POKEMON_AI_CHECKPOINT_EVERY=25000
POKEMON_AI_PROGRESS_EVERY=5000
POKEMON_AI_TOTAL_TIMESTEPS=1000000
POKEMON_AI_MAX_EPISODE_STEPS=20000

# Keep at 2 to preserve the existing checkpoint's action timing
POKEMON_AI_ACTION_REPEAT=2

# TensorBoard port (training profiles start it automatically; watch profiles do not)
POKEMON_AI_TENSORBOARD_PORT=6006

# Optional CPU thread-pool limits; loaded before NumPy/PyTorch imports
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
