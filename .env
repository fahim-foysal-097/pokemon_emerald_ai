# Pokémon Emerald starter-acquisition RL configuration.
# Main policy uses recurrent PPO (LSTM) and hybrid image + RAM + exploration observations.
POKEMON_AI_PROFILE=fast_train
POKEMON_AI_MODEL_NAME=emerald_ppo_hybrid_v1
POKEMON_AI_RESUME=1
POKEMON_AI_REQUIRE_START_STATE=1
POKEMON_AI_TRAINING_START_STATE=runtime_data/states/training_start.state

# The task starts on Route 101 after setting the clock and before obtaining the starter.
# This is start-state validation only; the policy receives no route coordinates/target hints.
POKEMON_AI_MAX_EPISODE_STEPS=30000
POKEMON_AI_TOTAL_TIMESTEPS=2000000
POKEMON_AI_NUM_ENVS=4
POKEMON_AI_CHECKPOINT_EVERY=25000
POKEMON_AI_PROGRESS_EVERY=1000
POKEMON_AI_VERBOSE=1

# GBA input timing: button press frames, then neutral release frames.
POKEMON_AI_ACTION_REPEAT=2
POKEMON_AI_ACTION_RELEASE_FRAMES=1
POKEMON_AI_HOST_CONTROL_ENABLED=0

# Observation capture is enabled in both GUI and headless modes. These only control diagnostics/display.
POKEMON_AI_FRAME_DIAGNOSTICS=0
POKEMON_AI_SETUP_DIAGNOSTICS_EVERY=300
POKEMON_AI_RECORD_VIDEO=0
POKEMON_AI_AUTO_START_TENSORBOARD=1
POKEMON_AI_TENSORBOARD_PORT=6006

# Evaluation is deterministic by default; stochastic watch is useful for diagnosis.
POKEMON_AI_EVAL_EPISODES=5
POKEMON_AI_EVAL_DETERMINISTIC=1
POKEMON_AI_EVAL_DIAGNOSTICS_EVERY=1000
POKEMON_AI_STOCHASTIC_WATCH=0

# Recurrent PPO; rollout size and batch size are compatible with six parallel environments.
POKEMON_AI_PPO_N_STEPS=2048
POKEMON_AI_PPO_BATCH_SIZE=256
POKEMON_AI_PPO_N_EPOCHS=10
POKEMON_AI_PPO_GAMMA=0.999
POKEMON_AI_PPO_GAE_LAMBDA=0.98
POKEMON_AI_PPO_LEARNING_RATE=0.0003
POKEMON_AI_ENTROPY_COEF_START=0.01
POKEMON_AI_ENTROPY_COEF_END=0.001
POKEMON_AI_LSTM_HIDDEN_SIZE=128

# Rewards: preserve movement, map/tile exploration, story, party, level, badge, trainer and task goals.
POKEMON_AI_STEP_PENALTY=0.00005
POKEMON_AI_LEVEL_REWARD=1.0
POKEMON_AI_BADGE_REWARD=50.0
POKEMON_AI_NEW_MAP_REWARD=0.75
POKEMON_AI_NEW_TILE_REWARD=0.02
POKEMON_AI_NEW_SCREEN_REWARD=0.002
POKEMON_AI_SCREEN_NOVELTY_CAP=0.05
POKEMON_AI_PARTY_MEMBER_REWARD=5.0
POKEMON_AI_TRAINER_WIN_REWARD=0.75
POKEMON_AI_LOOP_PENALTY=0.05
POKEMON_AI_LOOP_STAGNATION_STEPS=512
POKEMON_AI_LOOP_PENALTY_INTERVAL=256
POKEMON_AI_TASK_SUCCESS_REWARD=30.0

# Native mGBA log filtering. Increase VERBOSE to 2 to reveal known diagnostic chatter.
POKEMON_AI_MGBA_LOG_LEVEL=7
POKEMON_AI_FILTER_MGBA_CHATTER=1
POKEMON_AI_FILTER_KNOWN_MGBA_WARNINGS=1

# Bound BLAS/PyTorch CPU thread pools so emulator workers remain responsive.
# OMP_NUM_THREADS=2
# MKL_NUM_THREADS=2
# OPENBLAS_NUM_THREADS=1
# NUMEXPR_NUM_THREADS=1
